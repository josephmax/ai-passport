# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n

# --- 分区 ---
# 多合一挂坠:3MB 应用 + 5MB LittleFS 素材区(ADR-0002)。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
# 设置页二维码(连接手机)。
CONFIG_LV_USE_QRCODE=y
# LVGL 内置独立静态池:主屏常驻,只保留一个二级页。使用当前版本的字节配置项;
# 原 64 KiB 静态池挤占 BLE 的内部堆；页面按需销毁，48 KiB 留有渲染余量。
CONFIG_LV_MEM_SIZE=49152

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# app_main 的恢复流程持有较多局部结构(网络配置/快照解析),加宽主任务栈。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- 调试:捕获越界写(真机连续出现任务栈被打穿的隐形破坏) ---
# 堆投毒:缓冲区越界写会在下一次堆操作处立刻 abort 并带上调用者信息。
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
# 栈用量编译器检查:函数栈帧超限在编译期/运行期暴露。
CONFIG_COMPILER_STACK_CHECK_MODE_ALL=y

# --- Bluetooth ---
# BLE-only companion; Secure Connections with numeric comparison and bonds.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# C3 controller activities include advertising and connections. Reserve both,
# rather than the six-instance default (each unused instance costs 828 bytes).
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# Snapshots use acknowledged, explicitly framed chunks, never ATT long writes.
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=0
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_SM_LVL=4
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

{
  "name": "ai-passport-local-service",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted local service for the AI Passport multi-pendant: usage collectors, snapshot API, asset pipeline, weather, and the config portal.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "gen:placeholder": "tsx tools/gen-placeholder-bundle.ts",
    "smoke": "bash tools/smoke.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^9.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

# Copy to .env and adjust. Never commit a real .env or real API keys.

# HTTP port for both device API and config portal (default 3000)
PORT=3000
# Bind address. 0.0.0.0 exposes the service to the LAN (device + phone need this).
HOST=0.0.0.0

# Config portal login password (required for portal access; device API is unaffected)
PORTAL_PASSWORD=change-me

# Session cookie signing secret (32+ random chars). Generate e.g. via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the Claude Code projects log directory (default ~/.claude/projects)
# CLAUDE_PROJECTS_PATH=/Users/you/.claude/projects

# Optional: snapshot refresh interval in minutes (default 10)
# SNAPSHOT_REFRESH_MINUTES=10
